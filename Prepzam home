<style>
/* ============================================================
   TOKENS
   ============================================================ */
:root{
  --blue:#0B4F91;
  --blue-dark:#073766;
  --blue-light:#EAF3FF;
  --accent:#1684D4;
  --text:#15243A;
  --muted:#68778D;
  --bg:#F6F8FC;
  --white:#FFFFFF;
  --border:#E2E9F2;
  --green:#14865C;
  --radius:18px;
  --shadow:0 8px 28px rgba(18,48,85,.07);
  --shadow-lg:0 15px 40px rgba(11,79,145,.17);
  --ring:#7CC4FF;
  --ease:cubic-bezier(.2,.7,.3,1);
}

/* ============================================================
   BASE
   ============================================================ */
*,*::before,*::after{box-sizing:border-box}
*{margin:0;padding:0}

html{
  scroll-behavior:smooth;
  scroll-padding-top:88px;
  -webkit-text-size-adjust:100%;
}

body{
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  color:var(--text);
  background:var(--bg);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  text-rendering:optimizeLegibility;
  overflow-x:hidden;
}

a,button{-webkit-tap-highlight-color:transparent}

a:focus-visible,
button:focus-visible{
  outline:3px solid var(--ring);
  outline-offset:3px;
  border-radius:8px;
}

::selection{background:var(--blue);color:#fff}

/* ============================================================
   UTILITIES
   ============================================================ */
.sprite{position:absolute;width:0;height:0;overflow:hidden}

.icon{
  display:block;
  width:1em;
  height:1em;
  flex:none;
  fill:none;
  stroke:currentColor;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.icon--brand{fill:currentColor;stroke:none}

.sr-only{
  position:absolute;
  width:1px;height:1px;
  padding:0;margin:-1px;
  overflow:hidden;
  clip:rect(0 0 0 0);
  clip-path:inset(50%);
  white-space:nowrap;
  border:0;
}

.skip-link{
  position:absolute;
  top:-100px;
  left:50%;
  transform:translateX(-50%);
  z-index:200;
  padding:11px 22px;
  border-radius:0 0 12px 12px;
  background:var(--blue);
  color:#fff;
  font-size:.85rem;
  font-weight:800;
  text-decoration:none;
  transition:top .2s var(--ease);
}
.skip-link:focus{top:0}

.container{
  width:min(1080px,calc(100% - 36px));
  margin-inline:auto;
}

/* ============================================================
   REVEAL ON SCROLL
   ============================================================ */
.js .reveal{
  opacity:0;
  transform:translateY(18px);
  transition:opacity .6s var(--ease), transform .6s var(--ease);
  will-change:opacity, transform;
}
.js .reveal.is-visible{
  opacity:1;
  transform:none;
  will-change:auto;
}

/* ============================================================
   HEADER
   ============================================================ */
.header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(255,255,255,.94);
  border-bottom:1px solid var(--border);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
}

.header-inner{
  min-height:68px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
}

.brand-icon{
  width:41px;
  height:41px;
  display:grid;
  place-items:center;
  border-radius:12px;
  color:#fff;
  background:linear-gradient(135deg,var(--blue),var(--accent));
  font-size:23px;
  font-weight:900;
  line-height:1;
  box-shadow:0 4px 12px rgba(11,79,145,.2);
}

.brand-name{
  color:var(--blue);
  font-size:1.22rem;
  font-weight:900;
  letter-spacing:-.6px;
}

.header-label{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:7px 12px;
  border-radius:30px;
  background:var(--blue-light);
  color:var(--blue);
  font-size:.74rem;
  font-weight:750;
  white-space:nowrap;
}
.header-label .icon{font-size:.85rem}

/* ============================================================
   HERO
   ============================================================ */
.hero{
  position:relative;
  margin-top:22px;
  padding:48px 24px 40px;
  border-radius:25px;
  color:#fff;
  text-align:center;
  background:
    radial-gradient(circle at 90% 10%, rgba(255,255,255,.14), transparent 28%),
    radial-gradient(circle at 5% 100%, rgba(255,255,255,.10), transparent 28%),
    linear-gradient(135deg,#073766,#0B579E 60%,#1684D4);
  box-shadow:var(--shadow-lg);
}

.hero-content{
  position:relative;
  z-index:2;
  max-width:700px;
  margin-inline:auto;
}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:7px 14px;
  margin-bottom:20px;
  border:1px solid rgba(255,255,255,.24);
  border-radius:30px;
  background:rgba(255,255,255,.1);
  font-size:.79rem;
  font-weight:700;
}
.eyebrow .icon{font-size:.9rem;color:#8FE6C2}

.hero h1{
  margin-bottom:14px;
  font-size:clamp(2rem,5.5vw,3.4rem);
  line-height:1.12;
  letter-spacing:-1.6px;
  font-weight:900;
  text-wrap:balance;
}

.hero-description{
  max-width:570px;
  margin:0 auto 22px;
  color:rgba(255,255,255,.9);
  font-size:1rem;
  text-wrap:pretty;
}

/* ---- Download hint (inside hero, no card, no dismiss) ---- */
.download-action{
  position:relative;
  z-index:5;
  display:flex;
  flex-direction:column;
  align-items:center;
  width:100%;
  max-width:420px;
  margin:24px auto 0;
  padding:0;
  border:0;
  border-radius:0;
  background:transparent;
  color:#fff;
  box-shadow:none;
  animation:actionAppear .35s var(--ease);
}

.action-message{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  color:rgba(255,255,255,.95);
  font-size:.94rem;
  font-weight:850;
  line-height:1.4;
}

.action-message .icon{
  color:#8FE6C2;
  font-size:1.15rem;
}

.action-arrow{
  margin-top:6px;
  color:rgba(255,255,255,.9);
  animation:pointDown .9s ease-in-out infinite;
}
.action-arrow .icon{font-size:1.7rem}

@keyframes actionAppear{
  from{opacity:0;transform:translateY(-8px)}
  to{opacity:1;transform:translateY(0)}
}
@keyframes pointDown{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(6px)}
}

/* ---- Primary download button ---- */
.download-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:11px;
  min-height:58px;
  max-width:100%;
  padding:16px 27px;
  border:2px solid rgba(255,255,255,.65);
  border-radius:13px;
  background:#fff;
  color:var(--blue-dark);
  text-decoration:none;
  font-size:1rem;
  font-weight:900;
  box-shadow:0 8px 22px rgba(0,0,0,.17);
  transition:transform .2s var(--ease), box-shadow .2s var(--ease), background .2s, color .2s;
  cursor:pointer;
}
.download-button .icon{font-size:1.25rem}
.download-button:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 28px rgba(0,0,0,.22);
}
.download-button:active{transform:scale(.97)}

.hero-note{
  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  gap:7px;
  margin-top:14px;
  color:rgba(255,255,255,.85);
  font-size:.78rem;
}
.hero-note .icon{font-size:.85rem}

/* ============================================================
   QUICK BENEFITS
   ============================================================ */
.quick-benefits{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:13px;
  margin-top:22px;
}

.benefit{
  padding:21px 12px;
  border:1px solid var(--border);
  border-radius:var(--radius);
  background:#fff;
  box-shadow:var(--shadow);
  text-align:center;
}
.benefit .icon{
  font-size:1.4rem;
  margin:0 auto 9px;
  color:var(--accent);
}
.benefit h3{font-size:.9rem;font-weight:850}
.benefit p{margin-top:4px;color:var(--muted);font-size:.77rem}

/* ============================================================
   SECTIONS
   ============================================================ */
.section{margin-top:56px}

.section-heading{
  margin-bottom:23px;
  text-align:center;
}
.section-heading h2{
  font-size:clamp(1.45rem,3vw,2rem);
  line-height:1.25;
  letter-spacing:-.7px;
  font-weight:900;
  text-wrap:balance;
}
.section-heading p{
  max-width:600px;
  margin:9px auto 0;
  color:var(--muted);
  font-size:.92rem;
  text-wrap:pretty;
}

/* ============================================================
   FEATURES
   ============================================================ */
.features{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:15px;
}

.feature{
  padding:22px;
  border:1px solid var(--border);
  border-radius:var(--radius);
  background:#fff;
  box-shadow:var(--shadow);
  transition:transform .2s var(--ease), border-color .2s, box-shadow .2s;
}
.feature:hover{
  transform:translateY(-3px);
  border-color:#B8D7F5;
  box-shadow:0 12px 30px rgba(18,48,85,.10);
}

.feature-icon{
  display:grid;
  place-items:center;
  width:46px;
  height:46px;
  margin-bottom:15px;
  border-radius:13px;
  color:var(--blue);
  background:var(--blue-light);
}
.feature-icon .icon{font-size:1.15rem}

.feature h3{margin-bottom:6px;font-size:.98rem;font-weight:850}
.feature p{color:var(--muted);font-size:.83rem;line-height:1.65}

/* ============================================================
   EXAMS
   ============================================================ */
.exams{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:13px;
}

.exam{
  padding:21px 10px;
  border:1px solid var(--border);
  border-radius:var(--radius);
  background:#fff;
  box-shadow:var(--shadow);
  text-align:center;
  transition:transform .2s var(--ease), border-color .2s;
}
.exam:hover{transform:translateY(-3px);border-color:#B8D7F5}
.exam .icon{
  font-size:1.45rem;
  margin:0 auto 10px;
  color:var(--accent);
}
.exam h3{color:var(--blue);font-size:1.05rem;font-weight:900}
.exam p{margin-top:4px;color:var(--muted);font-size:.76rem}

/* ============================================================
   STEPS
   ============================================================ */
.steps{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:14px;
}

.step{
  padding:20px 16px;
  border:1px solid var(--border);
  border-radius:var(--radius);
  background:#fff;
}

.step-number{
  display:grid;
  place-items:center;
  width:36px;
  height:36px;
  margin-bottom:13px;
  border-radius:11px;
  background:var(--blue);
  color:#fff;
  font-weight:900;
}

.step h3{margin-bottom:6px;font-size:.92rem;font-weight:850}
.step p{color:var(--muted);font-size:.81rem}

/* ============================================================
   FINAL CTA
   ============================================================ */
.final-cta{
  margin-top:58px;
  padding:38px 22px;
  border:1px solid #CFE1F5;
  border-radius:23px;
  background:linear-gradient(135deg,#EAF3FF,#FFFFFF);
  text-align:center;
}

.final-icon{
  display:grid;
  place-items:center;
  width:55px;
  height:55px;
  margin:0 auto 15px;
  border-radius:17px;
  background:linear-gradient(135deg,var(--blue),var(--accent));
  color:#fff;
}
.final-icon .icon{font-size:1.45rem}

.final-cta h2{
  font-size:clamp(1.4rem,4vw,2rem);
  line-height:1.3;
  font-weight:900;
  text-wrap:balance;
}
.final-cta p{
  max-width:570px;
  margin:10px auto 0;
  color:var(--muted);
  font-size:.9rem;
}
.final-cta .download-button{
  margin-top:22px;
  border-color:var(--blue);
  background:var(--blue);
  color:#fff;
}
.final-cta .download-button:hover{background:var(--blue-dark);border-color:var(--blue-dark)}

/* ============================================================
   FOOTER
   ============================================================ */
.footer{
  margin-top:46px;
  padding:25px 0 110px;
  border-top:1px solid var(--border);
  text-align:center;
}
.footer-brand{color:var(--blue);font-size:1.1rem;font-weight:900}
.footer p{margin-top:5px;color:var(--muted);font-size:.82rem}
.footer .copyright{margin-top:15px;font-size:.75rem}

/* ============================================================
   FLOATING DOWNLOAD BAR
   ============================================================ */
.floating-bar{
  position:fixed;
  z-index:150;
  right:0;
  bottom:0;
  left:0;
  padding:11px 15px calc(11px + env(safe-area-inset-bottom));
  border-top:1px solid var(--border);
  background:rgba(255,255,255,.97);
  box-shadow:0 -5px 22px rgba(20,45,80,.09);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  transform:translateY(115%);
  visibility:hidden;
  transition:transform .28s var(--ease), visibility .28s;
}
.floating-bar.show{transform:translateY(0);visibility:visible}

.floating-inner{
  display:flex;
  align-items:center;
  gap:11px;
  width:min(600px,100%);
  margin-inline:auto;
}

.floating-logo{
  display:grid;
  place-items:center;
  flex-shrink:0;
  width:42px;
  height:42px;
  border-radius:12px;
  background:linear-gradient(135deg,var(--blue),var(--accent));
  color:#fff;
  font-size:1.2rem;
  font-weight:900;
}

.floating-text{flex:1;min-width:0}
.floating-text strong{display:block;font-size:.86rem;line-height:1.35}
.floating-text span{display:block;color:var(--muted);font-size:.72rem;line-height:1.35}

.floating-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  min-height:44px;
  padding:10px 16px;
  border-radius:10px;
  background:var(--blue);
  color:#fff;
  text-decoration:none;
  font-size:.82rem;
  font-weight:850;
  white-space:nowrap;
  transition:background .2s;
}
.floating-button .icon{font-size:1rem}
.floating-button:hover{background:var(--blue-dark)}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width:760px){
  .features{grid-template-columns:repeat(2,minmax(0,1fr))}
  .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
  .exams{grid-template-columns:repeat(2,minmax(0,1fr))}
}

@media (max-width:480px){
  .container{width:calc(100% - 26px)}

  .header-inner{min-height:62px}
  .brand-icon{width:37px;height:37px;font-size:20px}
  .brand-name{font-size:1.08rem}
  .header-label{padding:6px 9px;font-size:.67rem}

  .hero{margin-top:14px;padding:37px 16px 35px;border-radius:20px}
  .hero h1{font-size:2.05rem;letter-spacing:-1px}
  .hero-description{font-size:.9rem}

  .download-action{margin-top:18px}
  .action-message{font-size:.82rem}
  .action-arrow .icon{font-size:1.5rem}

  .download-button{width:100%;padding:15px 13px;font-size:.91rem}
  .hero-note{font-size:.71rem}

  .quick-benefits{gap:8px}
  .benefit{padding:15px 6px}
  .benefit h3{font-size:.78rem}
  .benefit p{font-size:.69rem}

  .section{margin-top:44px}

  .features{gap:10px}
  .feature{padding:16px 13px}
  .feature h3{font-size:.87rem}
  .feature p{font-size:.78rem}

  .steps{gap:10px}
  .step{padding:15px 12px}
  .step h3{font-size:.84rem}
  .step p{font-size:.77rem}

  .final-cta{margin-top:44px;padding:29px 17px}

  .floating-inner{gap:8px}
  .floating-logo{width:36px;height:36px;font-size:1.05rem}
  .floating-text strong{font-size:.79rem}
  .floating-text span{font-size:.66rem}
  .floating-button{padding:10px 12px;font-size:.76rem}
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{
    animation-duration:.001ms !important;
    animation-iteration-count:1 !important;
    transition-duration:.001ms !important;
    scroll-behavior:auto !important;
  }
  .js .reveal{opacity:1 !important;transform:none !important}
  .download-action,.floating-bar{transition:none !important}
}
</style>
</head>

