<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Prepzam – Academic Portal</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --primary:#0A4D8C; --primary-light:#EEF4FC; --bg:#F8FAFC; --card-bg:#FFFFFF;
  --text-main:#0F172A; --text-muted:#64748B; --border:#E2E8F0;
  --radius-lg:20px; --radius-md:14px; --radius-sm:10px;
  --shadow-sm:0 1px 3px rgba(15,23,42,.05);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{
  font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  background:var(--bg);color:var(--text-main);min-height:100vh;overflow-x:hidden;padding-bottom:40px;
}
.app-header-wrapper{position:sticky;top:0;z-index:1000;background:rgba(248,250,252,.94);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid rgba(226,232,240,.8);}
.app-header{max-width:560px;margin:0 auto;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;}
.brand-name{font-size:1.35rem;font-weight:800;color:var(--primary);letter-spacing:-0.5px;}
.header-badge{background:var(--primary-light);color:var(--primary);font-size:.75rem;font-weight:700;padding:6px 12px;border-radius:20px;}
.main-container{max-width:560px;margin:0 auto;padding:20px 16px;}

.redirect-notice{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-md);
  padding:18px 16px;text-align:center;margin-bottom:20px;box-shadow:var(--shadow-sm);}
.redirect-notice .spinner{width:28px;height:28px;border:3px solid var(--border);border-top-color:var(--primary);
  border-radius:50%;margin:0 auto 12px;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.redirect-notice p{font-size:.9rem;color:var(--text-muted);margin-bottom:4px;}
.redirect-notice strong{color:var(--text-main);font-size:.95rem;}
#fallbackCta{margin-top:14px;}

.hero-card{background:linear-gradient(135deg,#0A4D8C,#0284C7);border-radius:var(--radius-lg);
  padding:28px 24px;color:#fff;text-align:center;margin-bottom:20px;box-shadow:0 8px 24px rgba(10,77,140,.22);}
.hero-card h1{font-size:1.5rem;font-weight:800;margin-bottom:8px;letter-spacing:-0.3px;}
.hero-card p{font-size:.95rem;opacity:.92;margin-bottom:20px;line-height:1.5;}
.download-btn{display:inline-flex;align-items:center;gap:10px;background:#fff;color:#0A4D8C;
  padding:14px 26px;border-radius:50px;font-weight:700;font-size:.95rem;text-decoration:none;
  box-shadow:0 4px 14px rgba(0,0,0,.12);border:0;cursor:pointer;font-family:inherit;}
.download-btn:active{transform:scale(.97);}

.section-label{font-size:.78rem;font-weight:800;color:var(--text-muted);text-transform:uppercase;
  letter-spacing:.6px;margin-bottom:12px;padding:0 4px;}
.feature-list{display:flex;flex-direction:column;gap:12px;margin-bottom:24px;}
.feature-item{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-md);
  padding:16px;display:flex;align-items:center;gap:14px;box-shadow:var(--shadow-sm);}
.feature-icon{width:44px;height:44px;border-radius:var(--radius-sm);background:var(--primary-light);
  color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:1.1rem;
  flex-shrink:0;border:1px solid var(--border);}
.feature-text strong{display:block;font-size:1rem;font-weight:700;color:var(--text-main);margin-bottom:2px;}
.feature-text span{font-size:.82rem;color:var(--text-muted);font-weight:500;}

.exams-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:24px;}
.exam-chip{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-md);
  padding:14px 12px;text-align:center;box-shadow:var(--shadow-sm);}
.exam-chip strong{display:block;font-size:.95rem;color:var(--primary);font-weight:700;margin-bottom:2px;}
.exam-chip span{font-size:.75rem;color:var(--text-muted);}

.secondary-cta{text-align:center;margin-top:8px;}
.secondary-cta a{color:var(--primary);font-weight:600;font-size:.9rem;text-decoration:none;}
.secondary-cta a:hover{text-decoration:underline;}

.app-footer{max-width:560px;margin:28px auto 0;padding:16px;text-align:center;
  font-size:.78rem;color:var(--text-muted);}
.app-footer a{color:var(--primary);text-decoration:none;}
</style>
</head>
<body>

<div class="app-header-wrapper">
  <header class="app-header">
    <div class="brand-name">PREPZAM</div>
    <div class="header-badge">Academic Portal</div>
  </header>
</div>

<div class="main-container">

  <div class="redirect-notice" id="redirectNotice">
    <div class="spinner" id="spinner"></div>
    <p id="noticeText">Redirecting you to Google Play</p>
    <strong id="noticeSub">Prepzam – Download the app</strong>

    <!-- Always-available fallback button (hidden until needed) -->
    <a id="fallbackCta" class="download-btn" style="display:none;"
       href="https://play.google.com/store/apps/details?id=akoonax.aplicxyz"
       target="_blank" rel="noopener">
      <i class="fab fa-google-play"></i> Open Google Play
    </a>
  </div>

  <div class="hero-card">
    <h1>Smart Exam Preparation</h1>
    <p>Class notes, revision questions, past papers and AI-powered solutions — all in one place.</p>
    <a class="download-btn" href="https://play.google.com/store/apps/details?id=akoonax.aplicxyz"
       target="_blank" rel="noopener">
      <i class="fab fa-google-play"></i> Download on Google Play
    </a>
  </div>

  <div class="section-label">What You Get</div>
  <div class="feature-list">
    <div class="feature-item">
      <div class="feature-icon"><i class="fas fa-book-open"></i></div>
      <div class="feature-text"><strong>Class Notes</strong><span>Clear, organised notes for every subject</span></div>
    </div>
    <div class="feature-item">
      <div class="feature-icon"><i class="fas fa-rotate"></i></div>
      <div class="feature-text"><strong>Revision Questions</strong><span>Practice questions generated from your notes</span></div>
    </div>
    <div class="feature-item">
      <div class="feature-icon"><i class="fas fa-file-lines"></i></div>
      <div class="feature-text"><strong>Past Examination Questions</strong><span>Real past papers to prepare effectively</span></div>
    </div>
    <div class="feature-item">
      <div class="feature-icon"><i class="fas fa-brain"></i></div>
      <div class="feature-text"><strong>AI-Generated Solutions</strong><span>Step-by-step answers when you need them</span></div>
    </div>
  </div>

  <div class="section-label">Exams Covered</div>
  <div class="exams-grid">
    <div class="exam-chip"><strong>GCE</strong><span>O Level &amp; A Level</span></div>
    <div class="exam-chip"><strong>WAEC</strong><span>West Africa</span></div>
    <div class="exam-chip"><strong>JAMB</strong><span>UTME Prep</span></div>
    <div class="exam-chip"><strong>HND</strong><span>Higher Diploma</span></div>
  </div>

  <div class="secondary-cta">
    <a href="https://play.google.com/store/apps/details?id=akoonax.aplicxyz" target="_blank" rel="noopener">
      Not redirected? Tap here to download
    </a>
  </div>

</div>

<div class="app-footer">
  <p>&copy; 2026 Prepzam &nbsp;·&nbsp; <a href="mailto:prepzam@gmail.com">prepzam@gmail.com</a> &nbsp;·&nbsp; +237 652 170 978</p>
</div>

<script>
(function () {
  var PLAY_ID   = 'akoonax.aplicxyz';
  var PLAY_URL  = 'https://play.google.com/store/apps/details?id=' + PLAY_ID;
  var MARKET    = 'market://details?id=' + PLAY_ID;

  var inIframe  = window.top !== window.self;
  var isAndroid = /Android/i.test(navigator.userAgent);

  var spinner   = document.getElementById('spinner');
  var noticeTxt = document.getElementById('noticeText');
  var noticeSub = document.getElementById('noticeSub');
  var fallback  = document.getElementById('fallbackCta');

  var done = false;

  function showFallback() {
    if (done) return;
    spinner.style.display = 'none';
    noticeTxt.textContent = 'Tap below to continue';
    noticeSub.textContent = 'Opens Google Play in a new tab';
    fallback.style.display = 'inline-flex';
  }

  function redirect() {
    if (done) return;

    // ---------- Case 1: plain page (not embedded) ----------
    if (!inIframe) {
      done = true;
      if (isAndroid) {
        // Try the Play Store app, then fall back to the web URL
        window.location.href = MARKET;
        setTimeout(function () { window.location.href = PLAY_URL; }, 1200);
      } else {
        window.location.href = PLAY_URL;
      }
      return;
    }

    // ---------- Case 2: inside Google Sites iframe ----------
    // Attempt 1: break out to the top window.
    try {
      window.top.location.href = PLAY_URL;
      // If the browser allowed it, the page starts unloading.
      // If not, it throws or silently fails; the watchdog below catches it.
      done = true;
      return;
    } catch (e) { /* cross-origin / user-gesture block */ }

    // Attempt 2: open a new tab.
    try {
      var w = window.open(PLAY_URL, '_blank');
      if (w && !w.closed) { done = true; return; }
    } catch (e) { /* popup blocked */ }

    // Attempt 3: at minimum, try to navigate the iframe itself —
    // Google Play will still refuse, but the user is no worse off.
    try { window.location.href = PLAY_URL; } catch (e) {}

    // If we're still here, show the tap button.
    showFallback();
  }

  // Fire the redirect as early as possible
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', redirect, { once: true });
  } else {
    redirect();
  }

  // Second attempt once the full page (fonts, CSS) is loaded
  window.addEventListener('load', function () {
    setTimeout(redirect, 50);
  }, { once: true });

  // Watchdog: if we're still on the page after 1.5 s, reveal the button
  if (inIframe) {
    setTimeout(function () {
      if (!document.hidden) showFallback();
    }, 1500);
  }
})();
</script>
</body>
</html>
