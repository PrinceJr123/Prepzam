<script>
(function () {
  "use strict";

  /* ---------- Copyright year ---------- */
  var yearEl = document.getElementById("currentYear");
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  /* ---------- Floating bar visibility ---------- */
  var floatingBar = document.getElementById("floatingBar");
  var hero        = document.getElementById("home");
  var finalCta    = document.querySelector(".final-cta");
  var state       = { hero: true, cta: false };

  function syncFloatingBar() {
    if (!floatingBar) return;
    floatingBar.classList.toggle("show", !state.hero && !state.cta);
  }

  if (floatingBar && hero && "IntersectionObserver" in window) {
    var heroObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { state.hero = entry.isIntersecting; });
      syncFloatingBar();
    }, { threshold: 0 });

    var ctaObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { state.cta = entry.isIntersecting; });
      syncFloatingBar();
    }, { threshold: 0.35 });

    heroObserver.observe(hero);
    if (finalCta) ctaObserver.observe(finalCta);
  } else if (floatingBar) {
    /* Fallback for very old browsers */
    window.addEventListener("scroll", function () {
      var heroBottom = hero ? hero.getBoundingClientRect().bottom : 0;
      floatingBar.classList.toggle("show", heroBottom < 0);
    }, { passive: true });
  }

  /* ---------- Reveal on scroll ---------- */
  var reveals = document.querySelectorAll(".reveal");
  if (!reveals.length) return;

  if ("IntersectionObserver" in window) {
    var revealObserver = new IntersectionObserver(function (entries, observer) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.08, rootMargin: "0px 0px -6% 0px" });

    reveals.forEach(function (el) { revealObserver.observe(el); });
  } else {
    reveals.forEach(function (el) { el.classList.add("is-visible"); });
  }
})();
</script>

